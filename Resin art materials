<style>
/* Layout: milk-glass storefront. Sticky header, marbled "resin pour" arch hero, filterable product grid, slide-in cart that checks out to WhatsApp. */
:root {
  --bg: #F2F4FA;          /* cured-resin milk glass */
  --surface: #FFFFFF;
  --surface-2: #E9ECF6;
  --ink: #12163A;         /* ink navy from the logo */
  --muted: #5B6088;
  --line: #D9DDEE;
  --accent: #6B2FD6;      /* violet from the logo */
  --accent-soft: #E7DDFB;
  --pink: #E23E9B;        /* pink marble */
  --gold: #D9A93B;        /* gold foil */
  --wa: #168F4A;
  --wa-ink: #FFFFFF;
  --btn: #12163A;
  --btn-ink: #FFFFFF;
  --shadow: 0 1px 2px rgba(18,22,58,.06), 0 12px 32px -12px rgba(18,22,58,.18);
  --font-display: "Bricolage Grotesque", "Trebuchet MS", system-ui, sans-serif;
  --font-body: "Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
  --r: 18px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0B0D22; --surface: #14173A; --surface-2: #1C2048; --ink: #EEEFFC; --muted: #A2A7D3;
    --line: #2A2F5E; --accent: #A98BFF; --accent-soft: #2B2457; --pink: #FF6CBB; --gold: #F0C45C;
    --wa: #2BC36B; --wa-ink: #07210F; --btn: #EEEFFC; --btn-ink: #12163A;
    --shadow: 0 1px 2px rgba(0,0,0,.4), 0 12px 32px -12px rgba(0,0,0,.6);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0B0D22; --surface: #14173A; --surface-2: #1C2048; --ink: #EEEFFC; --muted: #A2A7D3;
  --line: #2A2F5E; --accent: #A98BFF; --accent-soft: #2B2457; --pink: #FF6CBB; --gold: #F0C45C;
  --wa: #2BC36B; --wa-ink: #07210F; --btn: #EEEFFC; --btn-ink: #12163A;
  --shadow: 0 1px 2px rgba(0,0,0,.4), 0 12px 32px -12px rgba(0,0,0,.6);
  color-scheme: dark;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 88px; }
body {
  background: var(--bg); color: var(--ink);
  font-family: var(--font-body); font-size: 16px; line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 0 96px;
}
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 60; background: var(--bg); }
h1, h2, h3 { font-family: var(--font-display); letter-spacing: -0.02em; text-wrap: balance; margin: 0; line-height: 1.05; }
p { margin: 0; }
a { color: inherit; }
button { font: inherit; color: inherit; cursor: pointer; }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 8px; }
.wrap { width: 100%; max-width: 1160px; margin-inline: auto; }
.eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }

/* Header */
.top { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; margin-inline: calc(-1 * max(16px, env(safe-area-inset-left, 0px))) calc(-1 * max(16px, env(safe-area-inset-right, 0px)));
  padding-inline: max(16px, env(safe-area-inset-left, 0px)) max(16px, env(safe-area-inset-right, 0px));
  background: color-mix(in srgb, var(--bg) 86%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
.top .wrap { display: flex; align-items: center; gap: 20px; min-height: 68px; }
.brand { display: flex; flex-direction: column; text-decoration: none; line-height: 1.1; min-width: 0; margin-right: auto; }
.brand b { font-family: var(--font-display); font-weight: 800; font-size: 20px; letter-spacing: -.02em; }
.brand span { font-size: 12px; color: var(--muted); }
.nav { display: flex; gap: 22px; font-weight: 600; font-size: 15px; }
.nav a { text-decoration: none; color: var(--muted); }
.nav a:hover { color: var(--ink); }
.cart-btn { display: inline-flex; align-items: center; gap: 10px; border: 1.5px solid var(--ink); background: transparent; border-radius: 999px; padding: 9px 16px; font-weight: 700; }
.cart-btn:hover { background: var(--btn); color: var(--btn-ink); }
.cart-btn .n { background: var(--accent); color: #fff; min-width: 22px; height: 22px; border-radius: 99px; display: grid; place-items: center; font-size: 12px; padding-inline: 6px; font-variant-numeric: tabular-nums; }
.cart-btn svg { width: 20px; height: 20px; }
@media (max-width: 760px) { .nav { display: none; } }

/* Hero */
.hero { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(28px, 6vw, 72px); align-items: center; padding-block: clamp(28px, 6vw, 72px) clamp(36px, 6vw, 72px); }
.hero h1 { font-size: clamp(40px, 7vw, 84px); font-weight: 800; margin-block: 14px 20px; }
.hero h1 em { font-style: normal; background: linear-gradient(100deg, var(--accent), var(--pink)); -webkit-background-clip: text; background-clip: text; color: transparent; }
.hero p.lead { font-size: clamp(17px, 2vw, 20px); color: var(--muted); max-width: 46ch; }
.cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; border-radius: 999px; padding: 14px 24px; font-weight: 700; text-decoration: none; border: 0; background: var(--btn); color: var(--btn-ink); transition: transform .15s, box-shadow .15s; }
.btn:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
.btn.ghost { background: transparent; color: var(--ink); border: 1.5px solid var(--line); }
.btn.wa { background: var(--wa); color: var(--wa-ink); }
.btn svg { width: 20px; height: 20px; flex: none; }
.facts { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 30px; font-size: 14px; color: var(--muted); font-weight: 500; }
.facts span::before { content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--gold); margin-right: 8px; }

.pour { position: relative; width: 100%; max-width: 440px; margin-inline: auto; aspect-ratio: 4/5; border-radius: 999px 999px 32px 32px; overflow: hidden; box-shadow: var(--shadow); background: var(--surface-2); isolation: isolate; }
.pour .marble { position: absolute; inset: -22%; filter: url(#marble);
  background:
    radial-gradient(40% 30% at 25% 30%, rgba(255,255,255,.9), transparent 70%),
    radial-gradient(35% 28% at 75% 65%, rgba(217,169,59,.85), transparent 70%),
    linear-gradient(115deg, #17206F 0%, #3B2AA8 18%, #8B3FD0 34%, #F2D6F5 46%, #E23E9B 58%, #FFFFFF 66%, #4A2BC9 78%, #12163A 100%); }
.pour .shine { position: absolute; inset: 0; background: linear-gradient(160deg, rgba(255,255,255,.45), transparent 38%, transparent 70%, rgba(255,255,255,.18)); mix-blend-mode: soft-light; pointer-events: none; }
.pour .slot { position: absolute; inset: 0; z-index: 1; }
.tag { position: absolute; z-index: 2; background: var(--surface); color: var(--ink); border-radius: 14px; padding: 10px 14px; box-shadow: var(--shadow); font-size: 13px; line-height: 1.25; }
.tag b { display: block; font-size: 15px; font-family: var(--font-display); }
.tag.a { left: 6%; bottom: 14%; } .tag.b { right: 6%; top: 24%; }
@media (max-width: 860px) { .hero { grid-template-columns: 1fr; } .pour { max-width: 340px; } }

/* Image slots */
.slot { position: relative; overflow: hidden; background: var(--surface-2); }
.slot .ph { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--font-display); font-weight: 800; font-size: clamp(28px, 6vw, 44px); color: color-mix(in srgb, var(--accent) 55%, var(--surface-2));
  background: radial-gradient(70% 70% at 30% 20%, color-mix(in srgb, var(--accent) 14%, transparent), transparent), linear-gradient(135deg, var(--surface-2), color-mix(in srgb, var(--accent-soft) 70%, var(--surface-2))); }
.slot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }

/* How it works */
.how { padding-block: clamp(24px, 4vw, 48px); }
.how ol { list-style: none; margin: 22px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; counter-reset: s; border-top: 1.5px solid var(--ink); }
.how li { counter-increment: s; padding: 20px 18px 8px 0; position: relative; }
.how li::before { content: counter(s); font-family: var(--font-display); font-weight: 800; font-size: 14px; color: var(--accent); display: block; margin-bottom: 10px; }
.how li b { display: block; font-family: var(--font-display); font-size: 20px; letter-spacing: -.01em; margin-bottom: 4px; }
.how li span { color: var(--muted); font-size: 15px; }
@media (max-width: 760px) { .how ol { grid-template-columns: 1fr 1fr; } }
@media (max-width: 420px) { .how ol { grid-template-columns: 1fr; } }

/* Shop */
.shop { padding-block: clamp(28px, 5vw, 64px); }
.shop-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 18px; margin-bottom: 22px; }
.shop-head h2 { font-size: clamp(32px, 5vw, 52px); font-weight: 800; margin-top: 8px; }
.search { position: relative; flex: 1 1 260px; max-width: 360px; }
.search input { width: 100%; font: inherit; color: var(--ink); background: var(--surface); border: 1.5px solid var(--line); border-radius: 999px; padding: 12px 18px 12px 44px; }
.search input::placeholder { color: var(--muted); }
.search svg { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: var(--muted); }
.chips { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 6px; margin-bottom: 22px; scrollbar-width: thin; }
.chip { flex: none; border: 1.5px solid var(--line); background: var(--surface); border-radius: 999px; padding: 8px 16px; font-weight: 600; font-size: 14px; }
.chip[aria-pressed="true"] { background: var(--btn); color: var(--btn-ink); border-color: var(--btn); }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 18px; }
@media (max-width: 520px) { .grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; display: flex; flex-direction: column; transition: transform .2s, box-shadow .2s; min-width: 0; }
.card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
.card .slot { aspect-ratio: 1/1; }
.card .body { padding: 14px 14px 14px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
.card h3 { font-size: 18px; letter-spacing: -.01em; line-height: 1.15; }
.card .note { font-size: 13px; color: var(--muted); line-height: 1.35; }
.card .row { margin-top: auto; padding-top: 10px; display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 52px; }
.price { font-weight: 700; font-variant-numeric: tabular-nums; }
.price small { display: block; font-weight: 500; font-size: 12px; color: var(--muted); }
.price.ask { font-size: 13px; font-weight: 600; color: var(--muted); }
.add { border: 1.5px solid var(--ink); background: transparent; border-radius: 999px; padding: 8px 16px; font-weight: 700; font-size: 14px; flex: none; }
.add:hover { background: var(--btn); color: var(--btn-ink); }
.qty { display: inline-flex; align-items: center; background: var(--btn); color: var(--btn-ink); border-radius: 999px; flex: none; }
.qty button { background: none; border: 0; width: 34px; height: 36px; font-size: 18px; font-weight: 700; color: inherit; }
.qty output { min-width: 22px; text-align: center; font-weight: 700; font-variant-numeric: tabular-nums; }
.empty { grid-column: 1 / -1; text-align: center; color: var(--muted); padding: 48px 12px; }

/* Custom request */
.ask { margin-block: clamp(24px, 4vw, 48px); background: var(--btn); color: var(--btn-ink); border-radius: 28px; padding: clamp(28px, 5vw, 56px); display: grid; grid-template-columns: 1.3fr 1fr; gap: 28px; align-items: center; position: relative; overflow: hidden; }
.ask::after { content: ""; position: absolute; right: -80px; top: -80px; width: 280px; height: 280px; border-radius: 50%; background: radial-gradient(circle at 30% 30%, var(--pink), var(--accent) 60%, transparent 72%); opacity: .55; filter: blur(8px); pointer-events: none; }
.ask h2 { font-size: clamp(28px, 4vw, 44px); font-weight: 800; }
.ask p { margin-top: 12px; opacity: .8; max-width: 48ch; }
.ask .side { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
.ask .num { font-family: var(--font-display); font-size: clamp(26px, 4vw, 38px); font-weight: 800; letter-spacing: .01em; font-variant-numeric: tabular-nums; user-select: all; }
.ask .btn.wa { background: var(--wa); color: var(--wa-ink); }
@media (max-width: 760px) { .ask { grid-template-columns: 1fr; } }

/* Studio */
.studio { padding-block: clamp(28px, 5vw, 64px); }
.studio h2 { font-size: clamp(30px, 4.5vw, 48px); font-weight: 800; margin-block: 8px 10px; }
.studio .sub { color: var(--muted); max-width: 54ch; }
.gal { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 26px; }
.gal figure { margin: 0; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.gal .slot { aspect-ratio: 4/5; border-radius: var(--r); }
.gal figcaption { font-weight: 600; font-size: 14px; }
@media (max-width: 760px) { .gal { grid-template-columns: repeat(2, 1fr); } }

/* Footer */
footer { border-top: 1px solid var(--line); padding-block: 32px; display: flex; flex-wrap: wrap; gap: 14px 28px; justify-content: space-between; align-items: center; color: var(--muted); font-size: 14px; }
footer b { font-family: var(--font-display); color: var(--ink); font-size: 18px; }
footer a { text-decoration-color: var(--line); text-underline-offset: 3px; }

/* Cart */
.scrim { position: fixed; inset: 0; background: rgba(8,10,30,.5); z-index: 70; opacity: 0; pointer-events: none; transition: opacity .25s; }
.scrim.on { opacity: 1; pointer-events: auto; }
.drawer { position: fixed; top: 0; right: 0; bottom: 0; width: min(440px, 100%); background: var(--surface); z-index: 80; display: flex; flex-direction: column; transform: translateX(104%); transition: transform .3s cubic-bezier(.2,.8,.2,1); visibility: hidden;
  padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px); padding-right: env(safe-area-inset-right, 0px); }
.drawer.on { transform: none; visibility: visible; box-shadow: -20px 0 60px -20px rgba(0,0,0,.4); }
.drawer header { display: flex; align-items: center; justify-content: space-between; padding: 18px 20px; border-bottom: 1px solid var(--line); }
.drawer header h2 { font-size: 26px; font-weight: 800; }
.x { border: 0; background: var(--surface-2); border-radius: 50%; width: 38px; height: 38px; font-size: 20px; line-height: 1; }
.lines { flex: 1; overflow-y: auto; padding: 8px 20px; }
.line { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; padding: 14px 0; border-bottom: 1px solid var(--line); align-items: center; }
.line b { font-family: var(--font-display); font-size: 17px; }
.line .u { color: var(--muted); font-size: 13px; }
.line .sum { font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; }
.line .qty { background: var(--surface-2); color: var(--ink); }
.line .rm { background: none; border: 0; color: var(--muted); font-size: 13px; text-decoration: underline; padding: 0; text-align: right; }
.cart-empty { text-align: center; color: var(--muted); padding: 56px 12px; }
.cart-empty b { display: block; font-family: var(--font-display); font-size: 22px; color: var(--ink); margin-bottom: 6px; }
.checkout { border-top: 1px solid var(--line); padding: 16px 20px 20px; display: flex; flex-direction: column; gap: 10px; background: var(--surface); }
.checkout input, .checkout textarea { width: 100%; font: inherit; color: var(--ink); background: var(--bg); border: 1.5px solid var(--line); border-radius: 12px; padding: 10px 14px; resize: none; }
.checkout input::placeholder, .checkout textarea::placeholder { color: var(--muted); }
.total { display: flex; justify-content: space-between; align-items: baseline; font-weight: 700; }
.total strong { font-family: var(--font-display); font-size: 26px; font-variant-numeric: tabular-nums; }
.fine { font-size: 12.5px; color: var(--muted); line-height: 1.4; }
.checkout .btn { width: 100%; }
.linkbtn { background: none; border: 0; color: var(--muted); font-size: 13px; text-decoration: underline; padding: 2px; align-self: center; }

.bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 12px max(16px, env(safe-area-inset-right, 0px)) calc(12px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px)); transform: translateY(120%); transition: transform .3s; pointer-events: none; }
.bar.on { transform: none; }
.bar button { pointer-events: auto; width: 100%; max-width: 560px; margin-inline: auto; display: flex; justify-content: space-between; align-items: center; background: var(--btn); color: var(--btn-ink); border: 0; border-radius: 999px; padding: 14px 22px; font-weight: 700; box-shadow: var(--shadow); }
.bar span:last-child { font-variant-numeric: tabular-nums; }
.toast { position: fixed; left: 50%; bottom: calc(90px + env(safe-area-inset-bottom, 0px)); transform: translate(-50%, 20px); background: var(--ink); color: var(--bg); padding: 10px 18px; border-radius: 999px; font-weight: 600; font-size: 14px; opacity: 0; pointer-events: none; transition: .25s; z-index: 90; }
.toast.on { opacity: 1; transform: translate(-50%, 0); }

@media (prefers-reduced-motion: no-preference) {
  .hero > * { animation: rise .7s both; } .hero > :nth-child(2) { animation-delay: .12s; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { transition: none !important; } }
</style>

