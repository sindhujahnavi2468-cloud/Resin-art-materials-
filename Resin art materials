    <div class="eyebrow">Behind the orders</div>
    <h2>Life In Frame · PriyaJay</h2>
    <p class="sub">A home studio sharing honest resin finds. Follow along for work in progress, dispatch days and customer reviews.</p>
    <div class="gal" id="gal"></div>
  </section>
</main>

<footer class="wrap">
  <div><b>Resin Art Materials</b><div>Home business · Pondicherry, Chennai, Trichy</div></div>
  <div>WhatsApp <span id="footPhone">97901 39453</span> · <a href="https://www.instagram.com/lifeinframepriyajay/" target="_blank" rel="noopener">@lifeinframepriyajay</a></div>
</footer>

<div class="scrim" id="scrim"></div>
<aside class="drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="cartTitle" aria-hidden="true">
  <header><h2 id="cartTitle">Your cart</h2><button class="x" id="closeCart" aria-label="Close cart">×</button></header>
  <div class="lines" id="lines"></div>
  <div class="checkout" id="checkout">
    <input id="custName" type="text" placeholder="Your name" autocomplete="name" aria-label="Your name">
    <textarea id="custNote" rows="2" placeholder="Delivery city or any note (optional)" aria-label="Note"></textarea>
    <div class="total"><span>Total</span><strong id="total">₹0</strong></div>
    <p class="fine" id="fine"></p>
    <a class="btn wa" id="sendWa" href="#" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.4 1.3-1.9 1.3-.5.1-1.1.1-1.8-.1a14 14 0 0 1-5.3-3.3 9.7 9.7 0 0 1-2-3.2c-.4-1.3.4-2.2.8-2.6.3-.3.9-.4 1.2-.1l.9 1.9c.1.3 0 .6-.2.8l-.5.6c-.1.2-.2.4 0 .6a8 8 0 0 0 3.1 2.8c.3.1.5.1.7-.1l.7-.9c.2-.3.5-.3.8-.2l1.9.9c.3.2.4.4.3.7Z"/></svg>
      Send order on WhatsApp</a>
    <button class="linkbtn" id="copyMsg" type="button">Copy order message instead</button>
  </div>
</aside>
<div class="bar" id="bar"><button id="barBtn" type="button"><span id="barN">0 items</span><span id="barT">View cart</span></button></div>
<div class="toast" id="toast" role="status"></div>

<script>
/* ============ EDIT ME ============ */
const CONFIG = {
  phone: "919790139453",          // WhatsApp number, country code first, digits only
  phoneDisplay: "97901 39453",
  currency: "₹",
  // Paste Cloudinary image links between the quotes. Leave "" to show a placeholder.
  heroImage: "",
  galleryImages: [
    { label: "Dispatch",        src: "" },
    { label: "Resin art",       src: "" },
    { label: "Work in progress",src: "" },
    { label: "Customer reviews",src: "" }
  ]
};
// For each product: img is the Cloudinary link ("" for now). price is a number in rupees, or null to quote on WhatsApp.
const PRODUCTS = [
  { id: "uv-resin",   name: "UV Resin",           cat: "Resin & Pigments", price: null, note: "200 gram. Clear hard type, fast curing, odourless.", img: "" },
  { id: "resin-hard", name: "Resin and Hardener", cat: "Resin & Pigments", price: null, note: "Small to large quantities available.", img: "" },
  { id: "pigment",    name: "Pigment",            cat: "Resin & Pigments", price: 60,   unit: "per piece", note: "Liquid colour pigments.", img: "" },
  { id: "mica",       name: "Mica",               cat: "Resin & Pigments", price: null, note: "Mica powder in many shades.", img: "" },
  { id: "bubble",     name: "Bubble Buster",      cat: "Resin & Pigments", price: 95,   note: "Spray for clearing bubbles from resin.", img: "" },
  { id: "silica",     name: "Silica Gel",         cat: "Resin & Pigments", price: null, note: "Crystals for drying flowers.", img: "" },

  { id: "moulds",     name: "Moulds",             cat: "Moulds", price: null, note: "More options available. Message to ask.", img: "" },
  { id: "jewel-m",    name: "Jewellery Mould",    cat: "Moulds", price: null, note: "", img: "" },
  { id: "candle-m",   name: "Candle Mould",       cat: "Moulds", price: null, note: "", img: "" },
  { id: "uv-m",       name: "UV Resin Mould",     cat: "Moulds", price: null, note: "", img: "" },
  { id: "latex",      name: "Liquid Latex",       cat: "Moulds", price: null, note: "For making your own moulds.", img: "" },

  { id: "chunks",     name: "Chunks and Glitter", cat: "Fillers & Décor", price: null, note: "", img: "" },
  { id: "alpha",      name: "Alphabet Chunks",    cat: "Fillers & Décor", price: 45,   unit: "per piece", note: "", img: "" },
  { id: "flowers",    name: "Dried Flowers",      cat: "Fillers & Décor", price: 110,  note: "", img: "" },
  { id: "rose",       name: "Rose Petals",        cat: "Fillers & Décor", price: null, note: "", img: "" },
  { id: "grass",      name: "Grass",              cat: "Fillers & Décor", price: null, note: "", img: "" },
  { id: "sand",       name: "Sand",               cat: "Fillers & Décor", price: null, note: "Coloured sand, 500 g.", img: "" },
  { id: "stones",     name: "Stones",             cat: "Fillers & Décor", price: null, note: "", img: "" },
  { id: "pearls",     name: "Pearls",             cat: "Fillers & Décor", price: null, note: "", img: "" },

  { id: "foam",       name: "Foam Board",         cat: "Craft & Findings", price: null, note: "Available in A3 and A4 sizes.", img: "" },
  { id: "pipe",       name: "Pipe Cleaners",      cat: "Craft & Findings", price: null, note: "", img: "" },
  { id: "tassels",    name: "Tassels",            cat: "Craft & Findings", price: null, note: "", img: "" },
  { id: "ring",       name: "Keychain Jump Ring", cat: "Craft & Findings", price: null, note: "", img: "" },
  { id: "markers",    name: "Markers",            cat: "Craft & Findings", price: null, note: "", img: "" },
  { id: "stickers",   name: "Stickers A",         cat: "Craft & Findings", price: 110,  note: "", img: "" },

  { id: "drill-m",    name: "Manual Drill",       cat: "Tools", price: null, note: "", img: "" },
  { id: "drill-e",    name: "Electric Drill Tool",cat: "Tools", price: null, note: "", img: "" },
  { id: "deburr",     name: "Deburring Tool",     cat: "Tools", price: null, note: "", img: "" },
  { id: "scale",      name: "Weighing Machine",   cat: "Tools", price: 230,  note: "", img: "" },
  { id: "stand",      name: "Stand",              cat: "Tools", price: null, note: "All types of stands available.", img: "" }
];
/* ================================= */

const $ = (s) => document.querySelector(s);
const fmt = (n) => CONFIG.currency + new Intl.NumberFormat("en-IN", { maximumFractionDigits: 0 }).format(n);
const byId = Object.fromEntries(PRODUCTS.map(p => [p.id, p]));
const CATS = ["All", ...new Set(PRODUCTS.map(p => p.cat))];
let cat = "All", query = "", cart = {};
try { cart = JSON.parse(localStorage.getItem("ram-cart") || "{}"); } catch (e) { cart = {}; }
Object.keys(cart).forEach(k => { if (!byId[k] || !(cart[k] > 0)) delete cart[k]; });
const save = () => { try { localStorage.setItem("ram-cart", JSON.stringify(cart)); } catch (e) {} };

function slot(src, label, cls) {
  const ini = (label || "?").trim().charAt(0).toUpperCase();
  return `<div class="slot ${cls || ""}"><div class="ph" aria-hidden="true">${ini}</div>${src ? `<img src="${src}" alt="${label}" loading="lazy" onerror="this.remove()">` : ""}</div>`;
}
const esc = (s) => String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

function renderChips() {
  $("#chips").innerHTML = CATS.map(c => `<button class="chip" type="button" data-cat="${esc(c)}" aria-pressed="${c === cat}">${esc(c)}</button>`).join("");
}
function ctrl(p) {
  const q = cart[p.id] || 0;
  return q
    ? `<div class="qty"><button type="button" data-dec="${p.id}" aria-label="Remove one ${esc(p.name)}">−</button><output>${q}</output><button type="button" data-inc="${p.id}" aria-label="Add one ${esc(p.name)}">+</button></div>`
    : `<button class="add" type="button" data-inc="${p.id}" aria-label="Add ${esc(p.name)} to cart">Add</button>`;
}
function renderGrid() {
  const list = PRODUCTS.filter(p => (cat === "All" || p.cat === cat) && (!query || (p.name + " " + p.note + " " + p.cat).toLowerCase().includes(query)));
  $("#grid").innerHTML = list.length ? list.map(p => `
    <article class="card" data-card="${p.id}">
      ${slot(p.img, p.name)}
      <div class="body">
        <h3>${esc(p.name)}</h3>
        ${p.note ? `<p class="note">${esc(p.note)}</p>` : ""}
        <div class="row">
          ${p.price != null ? `<div class="price">${fmt(p.price)}${p.unit ? `<small>${esc(p.unit)}</small>` : ""}</div>` : `<div class="price ask">Ask for price</div>`}
          <span data-ctrl="${p.id}">${ctrl(p)}</span>
        </div>
      </div>
    </article>`).join("") : `<p class="empty">Nothing matches that search. Message us on WhatsApp and we will help you find it.</p>`;
}

function totals() {
  let count = 0, sum = 0, quote = 0;
  for (const id in cart) { const p = byId[id], q = cart[id]; count += q; if (p.price != null) sum += p.price * q; else quote++; }
  return { count, sum, quote };
}
function message() {
  const name = $("#custName").value.trim(), note = $("#custNote").value.trim();
  const t = totals();
  const lines = Object.keys(cart).map((id, i) => {
    const p = byId[id], q = cart[id];
    return `${i + 1}. ${p.name} x ${q}` + (p.price != null ? ` (${fmt(p.price * q)})` : " (price to confirm)");
  });
  let m = "Hi, I would like to order from your Resin Art Materials catalogue:\n\n" + lines.join("\n");
  m += "\n\nTotal of priced items: " + fmt(t.sum);
  if (t.quote) m += "\nItems to quote: " + t.quote;
  if (name) m += "\n\nName: " + name;
  if (note) m += "\nNote: " + note;
  return m;
}
function waLink(text) { return "https://wa.me/" + CONFIG.phone + (text ? "?text=" + encodeURIComponent(text) : ""); }

function renderCart() {
  const t = totals(), ids = Object.keys(cart);
  $("#cartCount").textContent = t.count;
  $("#barN").textContent = t.count + (t.count === 1 ? " item" : " items");
  $("#barT").textContent = t.sum ? "View cart · " + fmt(t.sum) : "View cart";
  $("#bar").classList.toggle("on", t.count > 0 && !$("#drawer").classList.contains("on"));
  $("#lines").innerHTML = ids.length ? ids.map(id => {
    const p = byId[id], q = cart[id];
    return `<div class="line">
      <div><b>${esc(p.name)}</b><div class="u">${p.price != null ? fmt(p.price) + (p.unit ? " " + esc(p.unit) : " each") : "Price on WhatsApp"}</div></div>
      <div class="sum">${p.price != null ? fmt(p.price * q) : "—"}</div>
      <div class="qty"><button type="button" data-dec="${id}" aria-label="Remove one ${esc(p.name)}">−</button><output>${q}</output><button type="button" data-inc="${id}" aria-label="Add one ${esc(p.name)}">+</button></div>
      <button class="rm" type="button" data-rm="${id}">Remove</button></div>`;
  }).join("") : `<div class="cart-empty"><b>Your cart is empty</b>Add a few materials and they will show up here.</div>`;
  $("#checkout").hidden = !ids.length;
  $("#total").textContent = fmt(t.sum);
  $("#fine").textContent = t.quote ? `${t.quote} ${t.quote === 1 ? "item has" : "items have"} no listed price. We will confirm the final total on WhatsApp.` : "Delivery and final total are confirmed on WhatsApp.";
  $("#sendWa").href = waLink(message());
}
function setQty(id, d) {
  const q = Math.max(0, (cart[id] || 0) + d);
  if (q) cart[id] = q; else delete cart[id];
  save();
  document.querySelectorAll(`[data-ctrl="${id}"]`).forEach(el => el.innerHTML = ctrl(byId[id]));
  renderCart();
}

function openCart(on) {
  $("#drawer").classList.toggle("on", on); $("#scrim").classList.toggle("on", on);
  $("#drawer").setAttribute("aria-hidden", String(!on));
  renderCart();
  if (on) $("#closeCart").focus(); else $("#openCart").focus({ preventScroll: true });
}
let tt;
function toast(m) { const el = $("#toast"); el.textContent = m; el.classList.add("on"); clearTimeout(tt); tt = setTimeout(() => el.classList.remove("on"), 2200); }

document.addEventListener("click", (e) => {
  const t = e.target.closest("button, a"); if (!t) return;
  if (t.dataset.cat) { cat = t.dataset.cat; renderChips(); renderGrid(); }
  else if (t.dataset.inc) setQty(t.dataset.inc, 1);
  else if (t.dataset.dec) setQty(t.dataset.dec, -1);
  else if (t.dataset.rm) setQty(t.dataset.rm, -cart[t.dataset.rm]);
});
$("#q").addEventListener("input", (e) => { query = e.target.value.trim().toLowerCase(); renderGrid(); });
$("#openCart").onclick = () => openCart(true);
$("#barBtn").onclick = () => openCart(true);
$("#closeCart").onclick = () => openCart(false);
$("#scrim").onclick = () => openCart(false);
document.addEventListener("keydown", (e) => { if (e.key === "Escape" && $("#drawer").classList.contains("on")) openCart(false); });
["#custName", "#custNote"].forEach(s => $(s).addEventListener("input", () => { $("#sendWa").href = waLink(message()); }));
$("#sendWa").addEventListener("click", () => toast("Opening WhatsApp with your order"));
$("#copyMsg").onclick = async () => {
  const m = message();
  try { await navigator.clipboard.writeText(m); toast("Order message copied"); }
  catch (err) { const ta = $("#custNote"); toast("Copy blocked. Use the WhatsApp button instead."); }
};

/* static bits */
const hello = "Hi, I have a question about your resin art materials.";
$("#heroWa").href = waLink(hello); $("#askWa").href = waLink(hello);
$("#phoneText").textContent = CONFIG.phoneDisplay; $("#footPhone").textContent = CONFIG.phoneDisplay;
if (CONFIG.heroImage) $("#heroSlot").innerHTML = `<img src="${CONFIG.heroImage}" alt="" onerror="this.remove()" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">`;
$("#gal").innerHTML = CONFIG.galleryImages.map(g => `<figure>${slot(g.src, g.label)}<figcaption>${esc(g.label)}</figcaption></figure>`).join("");

renderChips(); renderGrid(); renderCart();
</script>
